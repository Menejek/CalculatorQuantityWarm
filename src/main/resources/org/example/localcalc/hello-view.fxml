<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.localcalc.HelloController"
      style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <fx:define>
        <ToggleGroup fx:id="modeGroup"/>
    </fx:define>

    <VBox alignment="CENTER_LEFT" spacing="10.0">
        <padding>
            <Insets left="25.0"/> <!-- Отступ ~1 см от левого края -->
        </padding>
        <RadioButton fx:id="rbSolid" text="Твёрдое топливо" toggleGroup="$modeGroup"
                     selected="true" userData="SOLID" style="-fx-font-size: 14px;"/>
        <RadioButton fx:id="rbLiquid" text="Жидкое топливо" toggleGroup="$modeGroup"
                     userData="LIQUID" style="-fx-font-size: 14px;"/>
        <RadioButton fx:id="rbGas" text="Газообразное топливо" toggleGroup="$modeGroup"
                     userData="GAS" style="-fx-font-size: 14px;"/>
    </VBox>

    <GridPane fx:id="inputGrid" hgap="10" vgap="12" alignment="CENTER"/>

    <Button text="Рассчитать НТС" onAction="#onCalculate"
            style="-fx-font-size: 14px; -fx-padding: 10 25; -fx-background-color: #2196F3; -fx-text-fill: white;"/>
    <Label fx:id="resultLabel" text="Результат: —"
           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
</VBox>
